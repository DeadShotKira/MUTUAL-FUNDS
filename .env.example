# Google OAuth 2.0 Client ID (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of Google accounts authorized to log in
DASHBOARD_ALLOWED_EMAILS=your.email@gmail.com,second.email@gmail.com

# 32+ character random string to sign HttpOnly session cookies
SESSION_SECRET=create_a_long_random_secret_string_here_32_chars_min

# URL of your Google Apps Script Web App (deployed as "Execute as: Me", "Who has access: Anyone")
# Example: https://script.google.com/macros/s/AKfycbxXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec
DASHBOARD_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# Shared secret matching DASHBOARD_API_SHARED_SECRET in Apps Script Properties
DASHBOARD_API_SHARED_SECRET=YOUR_SECRET_MATCHING_GAS_PROPERTIES
